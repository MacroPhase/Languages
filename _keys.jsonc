  // --- App Settings ---
  // --- Algorithms ---
  "algo_title": "Algorithms",
  "algo_weight_trend": "Weight Trend",
  "algo_v1_desc": "Simple causal moving average. Never revises history. Takes ~19 days to reflect real changes. Best if you want a predictable line that never surprises you.",
  "algo_trend_title_ewma": "EWMA",
  "algo_trend_title_3state": "3-State",
  "algo_v2_desc": "Models weight, rate of change, and acceleration as hidden states. Handles salt spikes and water retention smoothly by separating transient noise from genuine weight changes. May revise recent trend points slightly as new data arrives.",
  "algo_expenditure": "Expenditure",
  "algo_exp_title_standard": "Standard",
  "algo_exp_title_goal_aware": "Goal-Aware",
  "algo_exp_v1_desc": "14-day rolling TDEE with non-linear tissue density and allometric BMR. No goal awareness \u2014 treats all weight changes as raw energy balance signals.",
  "algo_exp_v3_desc": "Goal-aware expenditure estimation. Accounts for your active goal when interpreting weight changes \u2014 prevents starting a new diet from appearing as a metabolism spike. Automatically enabled when using 3-State trend.",
  "algo_prediction": "Prediction Style",
  "algo_pred_weight": "Weight Data",
  "algo_pred_weight_desc": "Extrapolate your current trend slope forward. Best when not following a coached plan or when you want the projection to reflect only what your data shows.",
  "algo_pred_blended": "Blended",
  "algo_pred_blended_desc": "Weighted mix of trend slope and your goal rate. Recommended if you\u2019re following a MacroPhase coaching plan and actively moving toward your goal.",
  "algo_pred_goal": "Goal Rate",
  "algo_pred_goal_desc": "Project using only your goal\u2019s weekly rate of change. Ignores current data \u2014 shows where you\u2019d be if you hit your target rate exactly.",
  "appsettings_algorithms": "Algorithms",
  "appsettings_configuration": "Configuration",

